# Async Task Queue API — Environment Variables
# Copy this file to .env and adjust values as needed.

# Application
TASKQUEUE_APP_NAME=Async Task Queue API
TASKQUEUE_APP_VERSION=0.1.0
TASKQUEUE_DEBUG=false

# Redis (broker DB 0, results DB 1, job store DB 2)
TASKQUEUE_REDIS_URL=redis://localhost:6379/0
TASKQUEUE_REDIS_RESULT_BACKEND=redis://localhost:6379/1
TASKQUEUE_REDIS_JOB_STORE_URL=redis://localhost:6379/2

# Celery
TASKQUEUE_CELERY_TASK_RESULT_EXPIRES=3600
TASKQUEUE_CELERY_TASK_SOFT_TIME_LIMIT=300
TASKQUEUE_CELERY_TASK_TIME_LIMIT=360

# Queues
TASKQUEUE_QUEUE_JOBS_HIGH=jobs_high
TASKQUEUE_QUEUE_JOBS_LOW=jobs_low

# Rate limiting
TASKQUEUE_RATE_LIMIT_MAX_REQUESTS=60
TASKQUEUE_RATE_LIMIT_WINDOW=60

# Job store
TASKQUEUE_JOB_RESULT_TTL=3600

# Worker
TASKQUEUE_WORKER_PREFETCH_MULTIPLIER=1
TASKQUEUE_WORKER_MAX_TASKS_PER_CHILD=100
